{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "dietrichgebert/ponytail"
      }
    },
    "fred-plugins": {
      "source": {
        "source": "github",
        "repo": "fredyu1996/claude_setup"
      }
    },
    "day-trader-skill": {
      "source": {
        "source": "github",
        "repo": "Jakeschincariol/day-trader-skill"
      }
    }
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "ponytail@ponytail": true,
    "agent-skills@fred-plugins": true,
    "fred-design@fred-plugins": true,
    "day-trader-skill@day-trader-skill": true
  },
  "model": "opus",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "skipWorkflowUsageWarning": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v codegraph >/dev/null 2>&1 && codegraph prompt-hook || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "mcp__alpaca__place_stock_order",
      "mcp__alpaca__cancel_order_by_id",
      "mcp__alpaca__replace_order_by_id",
      "mcp__alpaca__close_position"
    ],
    "deny": [
      "mcp__alpaca__close_all_positions",
      "mcp__alpaca__cancel_all_orders",
      "mcp__alpaca__place_option_order",
      "mcp__alpaca__place_crypto_order"
    ]
  }
}
